# Telegram MTProto (my.telegram.org) — NOT a BotFather token.
# Bot API cannot download >20 MB. A user account can do 2 GB (4 GB Premium).
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Produce once: python -m app.login
TELEGRAM_SESSION=

# Comma-separated Telegram user IDs allowed to send videos.
# Empty = only the logged-in account (Saved Messages / yourself).
ALLOWED_USER_IDS=

# Optional: mainland bilibili.com studio cookies (NOT the international app).
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
BILI_TID=122
BILI_TAGS=toondown
BILI_COPYRIGHT=1

# Hard cap. Also clamped to free disk minus 300 MB.
# Koyeb free disk is ~2 GB total including the image, so keep this realistic.
MAX_FILE_MB=1200

# Local PC + Android emulator/device only. Ignored on Koyeb.
# adb push <file> $ADB_REMOTE_DIR  then you tap Upload in the intl app.
ADB_ENABLED=0
ADB_BIN=adb
ADB_SERIAL=
ADB_REMOTE_DIR=/sdcard/Download/toondown

HOST=0.0.0.0
PORT=8000
