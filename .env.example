# from https://my.telegram.org  — these identify the APP, not you
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# USER login (needed for 2 GB). Create with: python -m app.login
TELEGRAM_SESSION=

# Optional instead of TELEGRAM_SESSION: a toondown.session file in the working dir.
# TELEGRAM_SESSION_NAME=toondown

# BotFather token — optional, NOT 2 GB. Bots are capped at ~20 MB.
# TELEGRAM_BOT_TOKEN=

ALLOWED_USER_IDS=

# Mainland bilibili.com WEB cookies. Not the international app.
# See README "SESSDATA / bili_jct".
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
BILI_TID=122
BILI_TAGS=toondown
BILI_COPYRIGHT=1

MAX_FILE_MB=16000
DATA_DIR=/tmp/toondown

ADB_ENABLED=0
ADB_BIN=adb
ADB_SERIAL=
ADB_REMOTE_DIR=/sdcard/Download/toondown

HOST=0.0.0.0
PORT=8000
