# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS origin of this service (no trailing slash).
# On Koyeb this is https://<app>-<org>.koyeb.app
PUBLIC_URL=https://your-app.koyeb.app
# Comma-separated Telegram user IDs allowed to upload. Empty = deny everyone.
ALLOWED_USER_IDS=123456789

# Optional: mainland bilibili.com web upload (NOT the international app).
# From browser cookies on member.bilibili.com while logged in.
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
# Partition id. 122 = 野生技能协会 (safe default). See README.
BILI_TID=122
BILI_TAGS=toondown
# 1 = original, 2 = reprint (requires a source URL in the caption)
BILI_COPYRIGHT=1

# Telegram Bot API getFile cap is 20 MB. Keep this at or below 19.
MAX_FILE_MB=19
