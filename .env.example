# Telegram MTProto (my.telegram.org) — NOT a BotFather token.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Produce once: python -m app.login
TELEGRAM_SESSION=

# Empty = only the logged-in account (Saved Messages / yourself).
ALLOWED_USER_IDS=

# Optional: mainland bilibili.com studio cookies (NOT the international app).
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
BILI_TID=122
BILI_TAGS=toondown
BILI_COPYRIGHT=1

# Soft cap. Real limit is min(this, free disk - 400 MB).
# Official Koyeb free instance is 2 GB SSD. If your box really has ~18 GB,
# /status will show it and jobs will use the free space.
MAX_FILE_MB=16000
DATA_DIR=/tmp/toondown

# Local PC + Android emulator/device only.
ADB_ENABLED=0
ADB_BIN=adb
ADB_SERIAL=
ADB_REMOTE_DIR=/sdcard/Download/toondown

HOST=0.0.0.0
PORT=8000
